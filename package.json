{
  "name": "agent-squash",
  "version": "0.2.0",
  "description": "One source of truth for every coding agent: CLAUDE.md and .claude/skills stay real, AGENTS.md, GEMINI.md, .agents/skills and every agent's global files become symlinks into them. Agent-scoped sections via <opencode> … </opencode> tags. Zero vendor lock-in.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/clawnify/agent-squash.git" },
  "keywords": ["agents.md", "opencode", "gemini-cli", "agent-squash", "claude", "claude-code", "codex", "cursor", "agent-skills", "symlink", "vendor-lock-in"],
  "type": "module",
  "bin": {
    "agent-squash": "dist/cli.js",
    "agentsquash": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
